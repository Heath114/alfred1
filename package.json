{
  "name": "alfred",
  "version": "1.0.0",
  "description": "Alfred: a private voice assistant on your Mac mini, driven from your iPhone",
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --experimental-strip-types src/server.ts",
    "telegram-login": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --experimental-strip-types scripts/telegram-login.ts",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "try": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --experimental-strip-types scripts/try.ts",
    "setup": "./setup.sh",
    "doctor": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --experimental-strip-types scripts/doctor.ts"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "telegram": "^2.26.22"
  },
  "engines": {
    "node": ">=22.13"
  }
}
