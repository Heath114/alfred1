# Alfred's password: the iPhone Shortcut sends it as "Authorization: Bearer <ALFRED_KEY>".
# Make one with: openssl rand -base64 24
ALFRED_KEY=

# The local model. Ollama (default): any model with tool support.
MODEL=qwen3:8b
# Or an OpenAI-style local server instead of Ollama, e.g. LM Studio:
# MODEL_URL=http://127.0.0.1:1234/v1
# MODEL=qwen3-8b

# Optional: your Telegram account (https://my.telegram.org → API development tools),
# then run: npm run telegram-login
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: notifications on the iPhone through Bark (npm run setup fills these in).
# BARK_URL=http://127.0.0.1:8080
# BARK_DEVICE_KEY=
# BARK_ENCRYPTION_KEY=          (32 characters, the same as in the Bark app's Push Encryption)
# BARK_PASSWORD=
# MAC_NOTIFICATIONS=off         (on by default)

# Optional: how long the Shortcut waits before Alfred answers "I'm on it" and finishes in the
# background (default 25 seconds), and the model's context window (default 12288 tokens).
# REPLY_WITHIN_SECONDS=25
# CONTEXT_LENGTH=12288

# Optional: where Alfred keeps files, people.json and its log (default ~/Alfred)
# ALFRED_FOLDER=
# PORT=8787
